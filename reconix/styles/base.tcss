/* Reconix TUI — shared widget styles.
   Colors are $variables from theme.CSS_TOKENS (fed in by ReconixApp.get_css_variables);
   never write a hex value here. */

Screen {
    background: $bg;
    color: $text;
}

/* ------------------------------------------------------------- buttons
   Keyboard-first: one-line buttons; the focused one is reversed. */
Button {
    min-width: 10;
    margin-right: 1;
    padding: 0 2;
    background: $raised;
    color: $text;
    text-style: bold;
}

Button.btn-ghost   { background: $raised; color: $text; }
Button.btn-primary { background: $green-bg; color: $green; }

Button:hover          { background: $border-strong; }
Button.btn-primary:hover { background: $green-bg; color: $text; }

Button:focus              { text-style: bold reverse; }
Button.btn-primary:focus  { background: $green; color: $bg; text-style: bold; }

Button:disabled {
    background: $surface2;
    color: $dim;
    text-style: none;
}

/* -------------------------------------------------------------- inputs */
Input {
    background: $surface;
    border: round $border-strong;
    color: $text;
    padding: 0 1;
}

Input:focus { border: round $cyan-dim; }

Input > .input--placeholder { color: $dim; }
Input > .input--cursor { background: $cyan; color: $bg; }

/* --------------------------------------------------- prompt (Claude-Code style) */
PromptBox {
    height: auto;
}

#prompt { margin: 0; }

#prompt-hint {
    height: 1;
    color: $dim;
    padding: 0 1;
}

/* Floats above the prompt input (overlay + lifted by its own height). */
#prompt-status {
    display: none;
    overlay: screen;
    constrain: none inside;
    offset-y: -100%;
    width: 100%;
    height: 1;
    padding: 0 1;
    background: $bg;
}

SuggestionMenu {
    display: none;
    overlay: screen;
    constrain: none inside;
    offset-y: -100%;
    width: 100%;
    background: $surface2;
    border-top: solid $border-strong;
    padding: 0 1;
    max-height: 10;
}

SuggestionMenu > .option-list--option-highlighted { background: $surface2; }

/* ------------------------------------------------ lists & tables (arrow keys) */
OptionList {
    background: $surface;
    border: round $border;
    padding: 0 1;
    height: auto;
    max-height: 18;
    scrollbar-color: $border-strong;
}

OptionList:focus { border: round $cyan-dim; }

OptionList > .option-list--option-highlighted {
    background: $raised;
    color: $text;
    text-style: bold;
}

OptionList:focus > .option-list--option-highlighted {
    background: $cyan-bg;
    color: $text;
}

OptionList > .option-list--separator { color: $border; }

/* --------------------------------------- choice menus (after OptionList rules) */
ChoiceMenu {
    background: $bg;
    border: none;
    padding: 0;
    height: auto;
    max-height: 12;
}

/* Textual tints focused lists; menus stay flat. */
ChoiceMenu:focus {
    border: none;
    background-tint: $bg 0%;
}

/* Like Claude Code: the pointer and colour mark the choice, no background band. */
ChoiceMenu > .option-list--option-highlighted,
ChoiceMenu:focus > .option-list--option-highlighted {
    background: $bg;
    text-style: none;
}

ChoiceMenu > .option-list--separator { color: $border-strong; }
ChoiceMenu > .option-list--option-hover { background: $raised; }

/* Question widget: chip, bold question, numbered choices, key hint. */
Question { height: auto; }

.chip {
    width: auto;
    height: 1;
    padding: 0 1;
    margin-bottom: 1;
    background: $cyan-dim;
    color: $text;
    text-style: bold;
}

.question {
    color: $text;
    text-style: bold;
    margin-bottom: 1;
}

.menu-hint {
    color: $dim;
    margin: 1 0;
}

DataTable {
    background: $surface;
    height: auto;
    max-height: 12;
    scrollbar-color: $border-strong;
}

DataTable > .datatable--header {
    background: $surface;
    color: $muted;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $cyan-bg;
    color: $text;
    text-style: bold;
}

DataTable > .datatable--hover { background: $raised; }

/* ----------------------------------------------------------- help modal */
HelpScreen {
    align: center middle;
    background: $bg 70%;
}

#help-box {
    width: 76;
    height: auto;
    background: $surface;
    border: round $cyan-dim;
    border-title-color: $cyan;
    padding: 1 2;
}

/* ---------------------------------------------------------- command bar */
CommandBarScreen {
    align: center bottom;
    background: $bg 40%;
}

#command-bar {
    width: 100%;
    height: auto;
    background: $surface;
    border-top: solid $border-strong;
    padding: 1 1 0 1;
}

/* -------------------------------------- choice dialog (/finding without an id) */
ChoiceScreen {
    align: center middle;
    background: $bg 70%;
}

.dialog {
    width: 96;
    max-width: 95%;
    height: auto;
    max-height: 90%;
    background: $surface;
    border: round $cyan-dim;
    border-title-color: $cyan;
    border-title-style: bold;
    padding: 1 2;
}

.dialog ChoiceMenu,
.dialog ChoiceMenu > .option-list--option-highlighted,
.dialog ChoiceMenu:focus > .option-list--option-highlighted {
    background: $surface;
}

/* Full shorthand: a lone margin-bottom would reset the other sides to 0. */
.dialog .menu-hint { margin: 1 0 0 0; }

/* A scrolling body inside a dialog (the Activity dialog). */
.dialog-body {
    height: auto;
    max-height: 60vh;
    margin-bottom: 1;
    scrollbar-color: $border-strong;
    scrollbar-background: $surface;
    scrollbar-size-vertical: 1;
}

/* ------------------------------------------------------------ notifications
   Toast has inherit_css=False, so it needs its own type selector. */
Toast {
    background: $surface;
    color: $text;
    padding: 0 1;
}

Toast.-information { border-left: outer $cyan; }
Toast.-warning     { border-left: outer $medium; }
Toast.-error       { border-left: outer $critical; }
